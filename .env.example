# --- Supabase (public: exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma separated: CASH,KASPI_QR,ONLINE (only enable methods with a real provider)
NEXT_PUBLIC_PAYMENT_METHODS=CASH

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# random 32+ bytes hex; used to HMAC OTP codes
OTP_HASH_SECRET=
# internal Supabase identity: 8XXXXXXXXXX@<domain> (never shown to customers)
AUTH_INTERNAL_EMAIL_DOMAIN=wa.tokburger.invalid

# Owner-approved test numbers with a fixed code (no WhatsApp sent). Remove to disable.
TEST_OTP_PHONES=+77474005347,+77474005348,+77474005349,+77474005350
TEST_OTP_CODE=

# WhatsApp bot service (./whatsapp-bot). Empty URL in production => login for other numbers is refused.
WHATSAPP_BOT_URL=
WHATSAPP_BOT_TOKEN=

# Optional self-hosted Nominatim for geocoding
NOMINATIM_URL=

# Same value as WHATSAPP_BOT_TOKEN in the site env (min 24 chars, random)
WHATSAPP_BOT_TOKEN=
PORT=3001
HOST=0.0.0.0

# Anti-ban pacing (defaults are conservative)
GAP_MIN_MS=2000
GAP_MAX_MS=6000
PER_RECIPIENT_10MIN=3
PER_RECIPIENT_DAY=8
GLOBAL_PER_HOUR=120
GLOBAL_PER_DAY=600
QUEUE_MAX=50
SEND_TIMEOUT_MS=45000

# Optional
# AUTO_REPLY_TEXT=
# SESSION_DIR=./.wwebjs_auth
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
